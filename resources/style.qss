/* ============================================================
 * Skill Manager — 出版装订 / 藏书票主题
 * 题材锚定：1300 本书籍 skill — 私人藏书目录
 * 象牙纸 + 烫金细线 + 朱印红 + 宋体贯穿正文
 * ============================================================ */

/* ---------- 全局 token ---------- */
QWidget {
    font-family: "Noto Serif SC", "Source Han Serif SC",
                 "SimSun", "STSong", "Georgia", serif;
    font-size: 13px;
    color: #1F2327;
    background-color: #F3ECE0;
    selection-background-color: #9B2C2C;
    selection-color: #F3ECE0;
}

QMainWindow {
    background-color: #F3ECE0;
}

/* ---------- 顶部 TitleBar 藏书票 ---------- */
QWidget#TitleBar {
    background-color: #F3ECE0;
}

QLabel#TitleMain {
    font-family: "Noto Serif SC", "Source Han Serif SC",
                 "SimSun", "STSong", serif;
    font-size: 26px;
    font-weight: 700;
    color: #1F2327;
    letter-spacing: 2px;
}

QLabel#TitleSub {
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
    color: #8B7F6C;
    padding-bottom: 4px;
}

QLineEdit#TitleSearch {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #C8BFAE;
    padding: 6px 4px;
    color: #1F2327;
    font-family: "Noto Serif SC", "Source Han Serif SC", serif;
    font-size: 13px;
    selection-background-color: #9B2C2C;
    selection-color: #F3ECE0;
}

QLineEdit#TitleSearch:focus {
    border-bottom-color: #9B2C2C;
}

QLineEdit#TitleSearch::placeholder {
    color: #B8ACA0;
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
}

QFrame#GoldRule {
    background-color: #C9A96E;
    border: none;
}

/* ---------- 侧栏 书脊 ---------- */
QWidget#Sidebar {
    background-color: #F3ECE0;
    border-right: 1px solid #C8BFAE;
}

QLabel#SidebarTitle {
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #C9A96E;
    padding: 18px 20px 4px 20px;
}

QLabel#SidebarCount {
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 11px;
    color: #8B7F6C;
    padding: 0 20px 14px 20px;
}

QTreeView#CategoryTree {
    background-color: #F3ECE0;
    border: none;
    outline: none;
    padding: 0;
}

QTreeView#CategoryTree::item {
    padding: 8px 20px 8px 22px;
    color: #4A4238;
    border-left: 1px solid #D8D2C2;
}

QTreeView#CategoryTree::item:hover {
    background-color: #EDE5D6;
    color: #1F2327;
}

QTreeView#CategoryTree::item:selected {
    background-color: transparent;
    color: #9B2C2C;
    border-left: 3px solid #9B2C2C;
    font-weight: 600;
}

QTreeView#CategoryTree::branch { background: transparent; }
QTreeView#CategoryTree QHeaderView { background: transparent; border: none; height: 0; }

/* ---------- 中栏 目录卡片 ---------- */
QWidget#ListPanel {
    background-color: #F3ECE0;
    border-right: 1px solid #C8BFAE;
}

QLabel#ListHeader {
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #C9A96E;
    padding: 18px 18px 4px 20px;
}

QTableView#SkillTable {
    background-color: #F3ECE0;
    border: none;
    outline: none;
    gridline-color: transparent;
    selection-background-color: transparent;
    selection-color: #9B2C2C;
}

QTableView#SkillTable::item {
    padding: 8px 18px 8px 20px;
    color: #4A4238;
    border-bottom: 1px solid #E8E1D3;
}

QTableView#SkillTable::item:hover {
    background-color: #EDE5D6;
}

QTableView#SkillTable::item:selected {
    background-color: #EDE5D6;
    color: #1F2327;
    border-left: 3px solid #9B2C2C;
}

QTableView#SkillTable QHeaderView::section {
    background-color: #F3ECE0;
    color: #8B7F6C;
    border: none;
    border-bottom: 1px solid #C8BFAE;
    padding: 10px 18px;
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 11px;
    font-weight: 500;
}

QLabel#ListFooter {
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 11px;
    color: #C9A96E;
    padding: 10px 20px;
    border-top: 1px solid #C8BFAE;
}

/* ---------- 右侧 内页 ---------- */
QFrame#DetailCard {
    background-color: #EFE7D8;
    border: 1px solid #C8BFAE;
}

QTabWidget#DetailTabs {
    background-color: transparent;
    border: none;
}

QTabWidget#DetailTabs::pane {
    border: none;
    border-top: 1px solid #C8BFAE;
}

QTabWidget#DetailTabs QTabBar::tab {
    background: transparent;
    color: #8B7F6C;
    border: none;
    padding: 12px 22px;
    margin-right: 0;
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
    border-bottom: 1px solid transparent;
}

QTabWidget#DetailTabs QTabBar::tab:hover {
    color: #4A4238;
}

QTabWidget#DetailTabs QTabBar::tab:selected {
    color: #9B2C2C;
    border-bottom-color: #9B2C2C;
    font-weight: 600;
}

/* ---------- 详情内容 ---------- */
QLabel#OverviewTitle {
    font-family: "Noto Serif SC", "Source Han Serif SC", serif;
    font-size: 22px;
    font-weight: 700;
    color: #1F2327;
    padding: 0 0 4px 0;
}

QLabel#OverviewMeta {
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 11px;
    color: #C9A96E;
    padding: 0 0 2px 0;
}

QLabel#OverviewSource {
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 11px;
    color: #8B7F6C;
    padding: 0 0 12px 0;
}

QLabel#SectionLabel {
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: #9B2C2C;
    padding: 14px 0 6px 0;
    border-bottom: 1px solid #C8BFAE;
}

QTextBrowser#OverviewDesc,
QTextBrowser#SkillMdView,
QTextBrowser#ChapterView,
QTextBrowser#RagView,
QTextBrowser#RagAnswerView {
    background-color: transparent;
    border: none;
    color: #1F2327;
    padding: 0;
    font-family: "Noto Serif SC", "Source Han Serif SC",
                 "SimSun", "STSong", "Georgia", serif;
    font-size: 14px;
    line-height: 1.9;
}

QListWidget#ChapterList {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#ChapterList::item {
    padding: 6px 12px;
    color: #4A4238;
    border-left: 2px solid transparent;
}

QListWidget#ChapterList::item:hover {
    background-color: #EDE5D6;
}

QListWidget#ChapterList::item:selected {
    background-color: #EDE5D6;
    color: #9B2C2C;
    border-left: 2px solid #9B2C2C;
}

/* ---------- 底部按钮栏 ---------- */
QWidget#CommandBar {
    background-color: #F3ECE0;
    border-top: 1px solid #C8BFAE;
}

QPushButton {
    background-color: #9B2C2C;
    color: #F3ECE0;
    border: none;
    padding: 7px 16px;
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #8A2626;
}

QPushButton:pressed {
    background-color: #731F1F;
}

QPushButton:disabled {
    background-color: #D8D2C2;
    color: #B8ACA0;
}

/* 次级按钮：朱印文字 + 细边框 */
QPushButton#SecondaryBtn {
    background-color: transparent;
    color: #4A4238;
    border: 1px solid #C8BFAE;
    padding: 6px 14px;
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
    font-size: 12px;
    border-radius: 0;
}

QPushButton#SecondaryBtn:hover {
    background-color: #EDE5D6;
    color: #9B2C2C;
    border-color: #9B2C2C;
}

QPushButton#SecondaryBtn:pressed {
    background-color: #D8D2C2;
}

/* 危险按钮 */
QPushButton#DangerBtn {
    background-color: transparent;
    color: #9B2C2C;
    border: 1px solid #C8BFAE;
}

QPushButton#DangerBtn:hover {
    background-color: #9B2C2C;
    color: #F3ECE0;
}

/* ---------- RAG 输入 ---------- */
QTextEdit#RagInput {
    background-color: #EFE7D8;
    border: 1px solid #C8BFAE;
    color: #1F2327;
    padding: 10px 14px;
    font-family: "Noto Serif SC", "Source Han Serif SC", serif;
    selection-background-color: #9B2C2C;
    selection-color: #F3ECE0;
    min-height: 60px;
}

QTextEdit#RagInput:focus {
    border-color: #9B2C2C;
}

/* ---------- 状态条 ---------- */
QStatusBar {
    background-color: #F3ECE0;
    color: #8B7F6C;
    border-top: 1px solid #E8E1D3;
    font-size: 11px;
    font-family: "Noto Sans SC", "Microsoft YaHei UI", sans-serif;
}

/* ---------- 分隔器 ---------- */
QSplitter::handle {
    background-color: #C8BFAE;
}

QSplitter::handle:hover {
    background-color: #9B2C2C;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px 0;
}

QScrollBar::handle:vertical {
    background-color: #C8BFAE;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #B8ACA0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0 2px;
}

QScrollBar::handle:horizontal {
    background-color: #C8BFAE;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #B8ACA0;
}

/* ---------- 弹窗 ---------- */
QDialog, QMessageBox {
    background-color: #F3ECE0;
}

QDialog QLabel, QMessageBox QLabel {
    color: #1F2327;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background-color: #EDE5D6;
    border: 1px solid #C8BFAE;
    height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #9B2C2C;
}

/* ---------- RAG 对话气泡 ---------- */
QLabel#UserBubble {
    background-color: #EDE5D6;
    color: #1F2327;
    padding: 10px 14px;
    border-left: 2px solid #C9A96E;
    font-family: "Noto Serif SC", serif;
}

QLabel#AiBubble {
    background-color: transparent;
    color: #9B2C2C;
    padding: 4px 0 4px 14px;
    border-left: 2px solid #9B2C2C;
    font-family: "Noto Serif SC", serif;
}

/* ---------- 输入框通用 ---------- */
QLineEdit, QComboBox {
    background-color: #EFE7D8;
    border: 1px solid #C8BFAE;
    padding: 6px 10px;
    color: #1F2327;
    font-family: "Noto Serif SC", "Source Han Serif SC", serif;
    selection-background-color: #9B2C2C;
    selection-color: #F3ECE0;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #9B2C2C;
}
