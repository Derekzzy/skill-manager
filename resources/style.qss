/* ============================================================
 * Skill Manager — 方案 A · Hacker Console 深色终端
 * 题材锚定：CLI 工具链 + git — 5600 skill 的 shell 控制台
 * 终端黑 + 终端绿 + 琥珀双 accent，Cascadia Code 贯穿
 * 防 AI 默认：不是酸绿 #00FF00，是 tmux 终端绿 #7AFEC6
 * 双 accent 语义分工（交互=绿，git状态=琥珀）
 * ============================================================ */

QWidget {
    font-family: "Cascadia Code", "JetBrains Mono", "Consolas",
                 "Microsoft YaHei UI", "PingFang SC", monospace;
    font-size: 13px;
    color: #B8C4BD;
    background-color: #0A0E0F;
    selection-background-color: #7AFEC6;
    selection-color: #0A0E0F;
}

QMainWindow { background-color: #0A0E0F; }

/* ---------- TitleBar · Bash Prompt ---------- */
QWidget#TitleBar {
    background-color: #0A0E0F;
}

QLabel#TitleMain {
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 14px;
    font-weight: 400;
    color: #B8C4BD;
}

QLabel#TitleHost {
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 600;
    color: #7AFEC6;
}

QLabel#TitlePath {
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 13px;
    color: #4A5650;
}

QLabel#TitleTags {
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 11px;
    color: #4A5650;
}

QLabel#TitleSub {
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    color: #4A5650;
}

QLineEdit#TitleSearch {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #1C2421;
    padding: 6px 4px;
    color: #B8C4BD;
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 13px;
    selection-background-color: #7AFEC6;
    selection-color: #0A0E0F;
}

QLineEdit#TitleSearch:focus {
    border-bottom-color: #7AFEC6;
}

QLineEdit#TitleSearch::placeholder {
    color: #3A4440;
}

QFrame#GoldRule {
    background-color: #1C2421;
    border: none;
}

/* ---------- 侧栏 ---------- */
QWidget#Sidebar {
    background-color: #0A0E0F;
    border-right: 1px solid #1C2421;
}

QLabel#SidebarTitle {
    font-size: 11px;
    color: #4A5650;
    letter-spacing: 1px;
    padding: 18px 20px 4px 20px;
}

QLabel#SidebarCount {
    font-size: 11px;
    color: #7AFEC6;
    padding: 0 20px 14px 20px;
}

QTreeView#CategoryTree {
    background-color: #0A0E0F;
    border: none;
    outline: none;
    padding: 0;
}

QTreeView#CategoryTree::item {
    padding: 7px 20px;
    color: #5A6B63;
    border-left: 2px solid transparent;
}

QTreeView#CategoryTree::item:hover {
    background-color: #0F1516;
    color: #B8C4BD;
}

QTreeView#CategoryTree::item:selected {
    background-color: transparent;
    color: #7AFEC6;
    border-left: 3px solid #7AFEC6;
}

QTreeView#CategoryTree::branch { background: transparent; }
QTreeView#CategoryTree QHeaderView { background: transparent; border: none; height: 0; }

/* ---------- 中栏 ---------- */
QWidget#ListPanel {
    background-color: #0A0E0F;
    border-right: 1px solid #1C2421;
}

QLabel#ListHeader {
    font-size: 11px;
    color: #4A5650;
    letter-spacing: 1px;
    padding: 18px 18px 4px 20px;
}

QTableView#SkillTable {
    background-color: #0A0E0F;
    border: none;
    outline: none;
    gridline-color: transparent;
    selection-background-color: transparent;
    selection-color: #7AFEC6;
}

QTableView#SkillTable::item {
    padding: 6px 18px;
    color: #5A6B63;
    border-bottom: 1px solid #0F1516;
}

QTableView#SkillTable::item:hover {
    background-color: #0F1516;
    color: #B8C4BD;
}

QTableView#SkillTable::item:selected {
    background-color: #0F1516;
    color: #7AFEC6;
    border-left: 2px solid #7AFEC6;
}

QTableView#SkillTable QHeaderView::section {
    background-color: #0A0E0F;
    color: #4A5650;
    border: none;
    border-bottom: 1px solid #1C2421;
    padding: 10px 18px;
    font-size: 11px;
    letter-spacing: 0;
}

QLabel#ListFooter {
    font-size: 11px;
    color: #7AFEC6;
    padding: 10px 20px;
    border-top: 1px solid #1C2421;
}

/* ---------- 右侧 ---------- */
QFrame#DetailCard {
    background-color: #0F1516;
    border: 1px solid #1C2421;
    border-radius: 0;
}

QTabWidget#DetailTabs {
    background-color: transparent;
    border: none;
}

QTabWidget#DetailTabs::pane {
    border: none;
    border-top: 1px solid #1C2421;
}

QTabWidget#DetailTabs QTabBar::tab {
    background: transparent;
    color: #4A5650;
    border: none;
    padding: 12px 22px;
    font-size: 12px;
    border-bottom: 1px solid transparent;
}

QTabWidget#DetailTabs QTabBar::tab:hover {
    color: #5A6B63;
}

QTabWidget#DetailTabs QTabBar::tab:selected {
    color: #7AFEC6;
    border-bottom-color: #7AFEC6;
    font-weight: 600;
}

QLabel#OverviewTitle {
    font-size: 20px;
    font-weight: 700;
    color: #B8C4BD;
    padding: 0 0 4px 0;
}

QLabel#OverviewMeta {
    font-size: 11px;
    color: #FFA627;  /* 琥珀 — 元数据/git状态 */
    padding: 0 0 2px 0;
}

QLabel#OverviewSource {
    font-size: 11px;
    color: #4A5650;
    padding: 0 0 12px 0;
}

QLabel#SectionLabel {
    font-size: 11px;
    font-weight: 500;
    color: #7AFEC6;
    padding: 14px 0 6px 0;
    border-bottom: 1px solid #1C2421;
}

QTextBrowser#OverviewDesc,
QTextBrowser#SkillMdView,
QTextBrowser#ChapterView,
QTextBrowser#RagView,
QTextBrowser#RagAnswerView {
    background-color: transparent;
    border: none;
    color: #B8C4BD;
    padding: 0;
    font-family: "Cascadia Code", "JetBrains Mono", "Consolas",
                 "Microsoft YaHei UI", monospace;
    font-size: 13px;
    line-height: 1.7;
}

QListWidget#ChapterList {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget#ChapterList::item {
    padding: 5px 10px;
    color: #5A6B63;
    border-left: 2px solid transparent;
}

QListWidget#ChapterList::item:hover {
    background-color: #0F1516;
    color: #B8C4BD;
}

QListWidget#ChapterList::item:selected {
    color: #7AFEC6;
    border-left: 2px solid #7AFEC6;
}

/* ---------- 底部 ---------- */
QWidget#CommandBar {
    background-color: #0A0E0F;
    border-top: 1px solid #1C2421;
}

QPushButton {
    background-color: #7AFEC6;
    color: #0A0E0F;
    border: none;
    padding: 6px 16px;
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    border-radius: 0;
}

QPushButton:hover { background-color: #6DE5B0; }
QPushButton:pressed { background-color: #5BC896; }
QPushButton:disabled {
    background-color: #1C2421;
    color: #3A4440;
}

QPushButton#SecondaryBtn {
    background-color: transparent;
    color: #5A6B63;
    border: none;
    border-left: 2px solid #1C2421;
    padding: 6px 14px;
    font-size: 12px;
    border-radius: 0;
}

QPushButton#SecondaryBtn:hover {
    background-color: #0F1516;
    color: #7AFEC6;
    border-left-color: #7AFEC6;
}

QPushButton#DangerBtn {
    background-color: transparent;
    color: #FFA627;
    border: 1px solid #1C2421;
}

QPushButton#DangerBtn:hover {
    background-color: #2A1E0F;
    border-color: #FFA627;
}

QTextEdit#RagInput {
    background-color: #0F1516;
    border: 1px solid #1C2421;
    color: #B8C4BD;
    padding: 10px 14px;
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    selection-background-color: #7AFEC6;
    selection-color: #0A0E0F;
    min-height: 60px;
}

QTextEdit#RagInput:focus { border-color: #7AFEC6; }

QStatusBar {
    background-color: #0A0E0F;
    color: #4A5650;
    border-top: 1px solid #0F1516;
    font-size: 11px;
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
}

QSplitter::handle { background-color: #1C2421; }
QSplitter::handle:hover { background-color: #7AFEC6; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px 0;
}
QScrollBar::handle:vertical {
    background-color: #1C2421;
    min-height: 30px;
    border-radius: 0;
}
QScrollBar::handle:vertical:hover { background-color: #2A3632; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0 2px;
}
QScrollBar::handle:horizontal {
    background-color: #1C2421;
    min-width: 30px;
    border-radius: 0;
}
QScrollBar::handle:horizontal:hover { background-color: #2A3632; }

QDialog, QMessageBox { background-color: #0A0E0F; }
QDialog QLabel, QMessageBox QLabel { color: #B8C4BD; }
QDialogButtonBox QPushButton { min-width: 80px; }

QProgressBar {
    background-color: #0F1516;
    border: 1px solid #1C2421;
    height: 6px;
    text-align: center;
    color: transparent;
    border-radius: 0;
}
QProgressBar::chunk { background-color: #7AFEC6; }

QLabel#UserBubble {
    background-color: #1C2421;
    color: #B8C4BD;
    padding: 10px 14px;
    border-left: 2px solid #4A5650;
}

QLabel#AiBubble {
    background-color: transparent;
    color: #7AFEC6;
    padding: 4px 0 4px 14px;
    border-left: 2px solid #7AFEC6;
}

QLineEdit, QComboBox {
    background-color: #0F1516;
    border: 1px solid #1C2421;
    padding: 6px 10px;
    color: #B8C4BD;
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    selection-background-color: #7AFEC6;
    selection-color: #0A0E0F;
}
QLineEdit:focus, QComboBox:focus { border-color: #7AFEC6; }
