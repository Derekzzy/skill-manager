/* Skill Manager · Theme 3 — Paper 浅石墨
   米白纸面 + 墨字 + 蓝 accent（Notion 风格浅色）*/

QWidget {
    font-family: "Inter", "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 13px;
    color: #232323;
    background-color: #FFFFFF;
    selection-background-color: #C5D6F7;
    selection-color: #1A1A1A;
}
QMainWindow { background-color: #FFFFFF; }

/* 顶栏 */
QWidget#TitleBar { background-color: #FFFFFF; border-bottom: 1px solid #E5E4DF; }
QLabel#AppDot { font-size: 14px; color: #2E62E8; }
QLabel#AppName { font-size: 16px; font-weight: 600; color: #1A1A1A; }
QLabel#AppSub { font-size: 12px; color: #8A8A86; }
QLabel#StatusDot { font-size: 11px; font-weight: 500; color: #2E883D;
    padding: 4px 10px; background-color: #F1F0ED; border-radius: 12px; }
QLabel#TitleMain,QLabel#TitleHost,QLabel#TitlePath,QLabel#TitleTags,QLabel#TitleSub { color: #232323; }

QLineEdit#TitleSearch {
    background-color: #F1F0ED; border: 1px solid #E5E4DF; border-radius: 6px;
    padding: 8px 14px; color: #1A1A1A; selection-background-color: #2E62E8;
    selection-color: #FFFFFF; font-size: 13px;
}
QLineEdit#TitleSearch:focus { border-color: #2E62E8; }
QLineEdit#TitleSearch::placeholder { color: #8A8A86; }

QFrame#GoldRule { background-color: #E5E4DF; border: none; }

/* 侧栏 */
QWidget#Sidebar { background-color: #FAFAF9; border-right: 1px solid #E5E4DF; }
QLabel#SidebarTitle { font-size: 11px; font-weight: 600; color: #8A8A86;
    letter-spacing: 1px; padding: 20px 18px 6px 18px; }
QLabel#SidebarCount { font-size: 11px; color: #B8B8B3; padding: 0 18px 14px 18px; }

QTreeView#CategoryTree { background-color: #FAFAF9; border: none; outline: none; padding: 4px 6px 12px 6px; }
QTreeView#CategoryTree::item { padding: 7px 14px; color: #4A4A48; border-radius: 5px; margin: 1px 4px; }
QTreeView#CategoryTree::item:hover { background-color: #ECEAE6; color: #1A1A1A; }
QTreeView#CategoryTree::item:selected { background-color: #E0E7F8; color: #2E62E8; }
QTreeView#CategoryTree::branch { background: transparent; }
QTreeView#CategoryTree QHeaderView { background: transparent; border: none; height: 0; }

/* 中栏 */
QWidget#ListPanel { background-color: #FFFFFF; border-right: 1px solid #E5E4DF; }
QLabel#ListHeader { font-size: 11px; font-weight: 600; color: #8A8A86;
    padding: 20px 18px 6px 18px; }

QTableView#SkillTable { background-color: #FFFFFF; border: none; outline: none;
    gridline-color: transparent; selection-background-color: #E0E7F8; selection-color: #2E62E8; padding: 0 8px; }
QTableView#SkillTable::item { padding: 8px 14px; color: #4A4A48; border-bottom: 1px solid #ECEAE6; }
QTableView#SkillTable::item:hover { background-color: #F5F4F1; }
QTableView#SkillTable::item:selected { background-color: #E0E7F8; color: #1A1A1A; }
QTableView#SkillTable QHeaderView::section {
    background-color: #FFFFFF; color: #8A8A86; border: none; border-bottom: 1px solid #E5E4DF;
    padding: 10px 18px; font-size: 11px; font-weight: 500;
}
QLabel#ListFooter { font-size: 11px; color: #B8B8B3; padding: 10px 18px; border-top: 1px solid #E5E4DF; }

/* 右侧卡片 */
QFrame#DetailCard { background-color: #F5F4F1; border: 1px solid #E5E4DF; border-radius: 8px; margin: 12px 14px 12px 0; }
QTabWidget#DetailTabs { background: transparent; border: none; }
QTabWidget#DetailTabs::pane { border: none; top: 2px; }
QTabWidget#DetailTabs QTabBar::tab {
    background: transparent; color: #8A8A86; border: none; padding: 10px 16px;
    font-size: 12px; font-weight: 500; border-bottom: 2px solid transparent;
}
QTabWidget#DetailTabs QTabBar::tab:hover { color: #4A4A48; }
QTabWidget#DetailTabs QTabBar::tab:selected { color: #2E62E8; border-bottom-color: #2E62E8; }

QLabel#OverviewTitle { font-size: 22px; font-weight: 600; color: #1A1A1A; padding: 6px 0 4px 0; }
QLabel#OverviewMeta { font-size: 11px; color: #2E62E8; padding: 0 0 2px 0; }
QLabel#OverviewSource { font-size: 11px; color: #8A8A86; padding: 0 0 14px 0; }
QLabel#SectionLabel { font-size: 11px; font-weight: 600; color: #2E62E8; letter-spacing: 1px; padding: 16px 0 8px 0; }

QTextBrowser#OverviewDesc,QTextBrowser#SkillMdView,QTextBrowser#ChapterView,
QTextBrowser#RagView,QTextBrowser#RagAnswerView {
    background: transparent; border: none; color: #232323; padding: 0;
    font-size: 13px; line-height: 1.8; font-family: "Inter", "Microsoft YaHei UI", sans-serif;
}
QListWidget#ChapterList { background: transparent; border: none; outline: none; }
QListWidget#ChapterList::item { padding: 7px 12px; color: #4A4A48; border-radius: 4px; }
QListWidget#ChapterList::item:hover { background-color: #ECEAE6; color: #1A1A1A; }
QListWidget#ChapterList::item:selected { background-color: #E0E7F8; color: #2E62E8; }

/* 底部 */
QWidget#CommandBar { background-color: #FFFFFF; border-top: 1px solid #E5E4DF; }

QPushButton {
    background-color: #F1F0ED; color: #1A1A1A; border: none;
    padding: 7px 16px; border-radius: 6px; font-size: 12px; font-weight: 500;
}
QPushButton:hover { background-color: #E5E4DF; color: #1A1A1A; }
QPushButton:pressed { background-color: #E0E7F8; }
QPushButton:disabled { background-color: #F1F0ED; color: #B8B8B3; }

QPushButton#SecondaryBtn {
    background: transparent; color: #2E62E8; border: 1px solid #E5E4DF;
    border-radius: 6px; padding: 6px 14px; font-size: 12px;
}
QPushButton#SecondaryBtn:hover { background-color: #E0E7F8; color: #2E62E8; border-color: #2E62E8; }
QPushButton#SecondaryBtn:pressed { background-color: #D0DBF2; }

QPushButton#DangerBtn { background: transparent; color: #C23B22; border: 1px solid #E5E4DF; border-radius: 6px; }
QPushButton#DangerBtn:hover { background-color: #C23B22; color: #FFFFFF; border-color: #C23B22; }

/* RAG / 输入 */
QTextEdit#RagInput {
    background-color: #FAFAF9; border: 1px solid #E5E4DF; border-radius: 6px;
    color: #1A1A1A; padding: 10px 14px; font-size: 13px;
    selection-background-color: #2E62E8; selection-color: #FFFFFF; min-height: 60px;
}
QTextEdit#RagInput:focus { border-color: #2E62E8; }

QStatusBar { background-color: #FAFAF9; color: #8A8A86; border-top: 1px solid #E5E4DF; font-size: 11px; }

QSplitter::handle { background-color: #E5E4DF; }
QSplitter::handle:hover { background-color: #2E62E8; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical   { height: 2px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px 2px 2px 0; }
QScrollBar::handle:vertical { background: #E5E4DF; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #D0DBF2; }
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0 2px; }
QScrollBar::handle:horizontal { background: #E5E4DF; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #D0DBF2; }

QDialog,QMessageBox { background-color: #FFFFFF; }
QDialog QLabel,QMessageBox QLabel { color: #1A1A1A; }
QDialogButtonBox QPushButton { min-width: 80px; }

QProgressBar { background: #F1F0ED; border: none; border-radius: 4px; height: 6px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #2E62E8; border-radius: 4px; }

QLabel#UserBubble { background: #F1F0ED; color: #1A1A1A; padding: 10px 14px; border-radius: 6px; }
QLabel#AiBubble { background: transparent; color: #2E62E8; padding: 4px 0 4px 14px; border-left: 2px solid #2E62E8; }

QLineEdit,QComboBox {
    background-color: #FAFAF9; border: 1px solid #E5E4DF; border-radius: 6px;
    padding: 7px 10px; color: #1A1A1A; font-size: 13px;
    selection-background-color: #2E62E8; selection-color: #FFFFFF;
}
QLineEdit:focus,QComboBox:focus { border-color: #2E62E8; }
